{
  "name": "lidifin-frontend",
  "version": "1.4.3",
  "description": "Lidifin web frontend",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamzercise/lidifin.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "icons:fix": "python3 scripts/remove_checkerboard.py",
    "icons:generate": "python3 scripts/generate_pwa_icons.py",
    "icons": "npm run icons:fix && npm run icons:generate",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3030",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:predeploy": "playwright test tests/e2e/predeploy --reporter=list",
    "test:predeploy:ui": "playwright test tests/e2e/predeploy --ui",
    "test:predeploy:headed": "playwright test tests/e2e/predeploy --headed",
    "analyze": "ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.90.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "focus-trap-react": "^12.0.1",
    "framer-motion": "^12.23.26",
    "howler": "^2.2.4",
    "lucide-react": "^0.552.0",
    "next": "^16.0.10",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.1.3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/howler": "^2.2.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
